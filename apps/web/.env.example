# The Express API (TZ §24.1 — Next is a BFF proxy, it never talks to MongoDB).
API_URL=http://localhost:4000

NEXT_PUBLIC_SITE_URL=https://leader-learning-center-git-a34999-shohjahons-projects-025d24e7.vercel.app/

# TZ §6.3 — analytics. Leave blank to ship zero third-party script bytes;
# each tag loads only when its id is present.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Browser-side calls to the Express API (TZ 24.1 - BFF handles only auth cookies).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Sample content (student results, testimonials, teacher profiles).
# Set to false before publishing — see src/content/sample.ts.
NEXT_PUBLIC_SAMPLE_CONTENT=true
