NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# MongoDB must be a replica set — payment/invoice writes run in transactions (TZ 26.4).
# With Docker:  docker compose -f ../../infra/docker-compose.yml up -d
# MONGO_URL=mongodb://localhost:27017/leader?replicaSet=rs0

# Without Docker, for local development only: an in-memory single-node replica set.
USE_MEMORY_DB=true

# REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

# ── Authentication (TZ §8) ───────────────────────────────────────────────────
# Both are generated per boot outside production, and are REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=
# ENCRYPTION_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN=.leaderonline.uz

# The first SuperAdmin. Remove both once the account exists and has changed its
# password — the account cannot sign in until it has enrolled 2FA (§8).
# SEED_SUPERADMIN_PHONE=+998901234567
# SEED_SUPERADMIN_PASSWORD=

# TZ 26.4 requires a replica set for payment transactions.
# Dev-only escape hatch for a standalone mongod:
ALLOW_NON_TRANSACTIONAL_PAYMENTS=false
