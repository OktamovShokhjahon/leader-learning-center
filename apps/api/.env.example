NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# MongoDB must be a replica set — payment/invoice writes run in transactions (TZ 26.4).
# With Docker:  docker compose -f ../../infra/docker-compose.yml up -d
# MONGO_URL=mongodb://localhost:27017/leader?replicaSet=rs0

# Without Docker, for local development only: an in-memory single-node replica set.
USE_MEMORY_DB=true

# REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
