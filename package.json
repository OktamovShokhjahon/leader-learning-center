{
  "name": "leader-lc",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@leader/web",
    "dev:api": "npm run dev --workspace=@leader/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "build:shared": "npm run build --workspace=@leader/shared",
    "predev": "npm run build:shared",
    "predev:api": "npm run build:shared",
    "prebuild": "npm run build:shared",
    "pretypecheck": "npm run build:shared",
    "pretest": "npm run build:shared",
    "seed": "npm run seed --workspace=@leader/api",
    "preseed": "npm run build:shared",
    "smoke": "npm run smoke --workspace=@leader/api"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "mongodb-memory-server@10.4.3": true
  }
}
